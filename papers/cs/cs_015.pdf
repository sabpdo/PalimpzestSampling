      <rdf:Description rdf:about=""
            xmlns:sn="http://springernature.com/ns/xmpExtensions/2.0/"
            xmlns:author="http://springernature.com/ns/xmpExtensions/2.0/authorInfo/">
         <sn:authorInfo>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <author:name>Maolin Du</author:name>
                  <author:orcid>http://orcid.org/0000-0003-3740-0043</author:orcid>
               </rdf:li>
            </rdf:Bag>
         </sn:authorInfo>
