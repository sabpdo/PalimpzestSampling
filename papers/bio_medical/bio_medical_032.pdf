         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The role of extracellular traps in ischemia reperfusion injury</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Feilong Zhang; Yuqing Li; Jiyue Wu; Jiandong Zhang; Peng Cao; Zejia Sun; Wei Wang</rdf:li>
