         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">In response to strong signals, several types of immune cells release extracellular traps (ETs), which are web-like structures consisting of DNA decorated with various protein substances</rdf:li>
            </rdf:Alt>
         </dc:description>
